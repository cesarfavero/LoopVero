{
  "name": "thegrok-desktop",
  "productName": "Grok Bot",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 4180 --strictPort\" \"wait-on http://127.0.0.1:4180 && node scripts/launch-electron.cjs src/main.cjs --dev\"",
    "build": "vite build",
    "start": "node scripts/launch-electron.cjs src/main.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.4",
    "wait-on": "^9.0.6"
  }
}

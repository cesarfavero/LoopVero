{
  "name": "harness-reference-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Static AST indexing for original harness reference files",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "index": "node --expose-gc --max-old-space-size=4096 index-harness.cjs",
    "render": "python3 render-catalog.py",
    "verify": "python3 verify-reference.py"
  },
  "dependencies": {
    "acorn": "8.18.0"
  }
}
